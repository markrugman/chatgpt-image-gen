# Copy to server/.env. Never commit the real file.
# Existing servers: keep your current key unchanged.
# New servers: leave empty to generate /data/server-access-key on first start.
# Or set your own random key: openssl rand -hex 32
IMAGEGEN_SERVER_TOKEN=
IMAGEGEN_SERVER_NAME=My Image Gen Server
# Use the VM LAN IP to connect from your home network.
# Keep 127.0.0.1 for access only through a reverse proxy on this host.
IMAGEGEN_BIND_ADDRESS=127.0.0.1
IMAGEGEN_PORT=8787

# Optional browser generation. Desktop generation always stays on the PC.
IMAGEGEN_WORKER_ENABLED=false
